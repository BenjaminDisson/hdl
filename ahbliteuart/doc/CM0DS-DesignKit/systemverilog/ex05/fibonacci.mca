// fibonacci.mca

// Fibonacci sequence program for miniCPU

// Memory usage:
// mem[0x10] = starting memory address
// mem[0x11] = number of steps required

@0  // ------ START OF PROGRAM --------
1101_001_000_010000    // 0: r1 = mem[0x10]  // find start adrs
1101_110_000_010001    // 1: r6 = mem[0x11]  // find count
1100_011_000000001     // 2: r3 = 1          // init cache
1100_100_000000000     // 3: r4 = 0          // init cache2

0_0_00_010_011_100_000 // 4: LOOPSTART: r2 = r3 + r4
1110_011_001_000000    // 5: mem[r1] = r3
0_0_00_100_011_000_000 // 6: r4 = r3
0_1_00_011_000_010_001 // 7: r3 = ~0 & r2
0_0_01_001_001_000_000 // 8: r1 = r1 + 1
0_1_00_110_000_110_000 // 9: r6 = -1 + r6
1111_101_111_111001    //10: jnz LOOPSTART = pc-7

1000_0000_0000_0000    //11: halt
// ------- END OF PROGRAM -------

@10  // Data start
0000_0000_0010_0000 // start at 0x20
0000_0000_0001_0100 // 20 (dec) terms
